{
  "name": "@openuidev/example-grok-build",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate": "openui generate src/library.ts --spec --out src/generated/spec.json",
    "generate:apiKey": "openui generate-api-key",
    "predev": "npm run generate",
    "dev": "node scripts/launch.mjs dev",
    "prebuild": "npm run generate",
    "build": "next build --webpack",
    "start": "node scripts/launch.mjs start",
    "lint": "eslint",
    "pretest": "npm run generate",
    "test": "vitest run",
    "pretypecheck": "npm run generate",
    "typecheck": "tsc --noEmit",
    "preverify": "npm run generate",
    "verify": "tsc --noEmit && vitest run && next build --webpack"
  },
  "dependencies": {
    "@ag-ui/core": "^0.0.53",
    "@agentclientprotocol/sdk": "1.3.0",
    "@openuidev/lang-core": "0.2.17",
    "@openuidev/react-headless": "0.9.13",
    "@openuidev/react-lang": "0.2.15",
    "@openuidev/react-ui": "0.13.10",
    "@openuidev/thesys": "0.3.2",
    "ai": "^6.0.0",
    "next": "16.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "4.4.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@openuidev/cli": "0.2.12",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.15.32",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@openuidev/lang-core",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10"
    }
  },
  "allowScripts": {
    "@openuidev/lang-core": true,
    "sharp": true,
    "unrs-resolver": true
  }
}
