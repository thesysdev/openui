# OpenUI Cloud API key — https://console.thesys.dev/keys
THESYS_API_KEY=sk-th-...

# Optional Cloud model id. Must exist in src/lib/openui-cloud-models.json unless you
# add it there first.
# OPENUI_MODEL=google/gemini-3.6-flash-free

# ----------------------------------------------------------------------------
# Optional app settings (all have sensible defaults)
# ----------------------------------------------------------------------------

# Workspace directory the coding agent reads/writes in (default: the server's cwd)
# PI_AGENT_CWD=

# Set to "read-only" to disable the bash/edit/write tools (recommended if exposed)
# PI_WEB_TOOLS=full

# Dev/prod server port
# PORT=3000
