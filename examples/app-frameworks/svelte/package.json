{
  "name": "@openuidev/example-svelte",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:apiKey": "openui generate-api-key",
    "prepare": "svelte-kit sync || echo ''",
    "dev": "svelte-kit sync && vite dev",
    "build": "svelte-kit sync && vite build",
    "verify": "svelte-kit sync && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.41",
    "@ai-sdk/svelte": "^4.0.191",
    "@openuidev/lang-core": "0.2.17",
    "@openuidev/svelte-lang": "0.1.2",
    "ai": "^6.0.116",
    "chart.js": "^4.5.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@openuidev/cli": "0.2.12",
    "@sveltejs/adapter-auto": "^4.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4",
    "svelte": "^5.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@openuidev/lang-core",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "@sveltejs/kit>cookie": "1.1.1"
    }
  },
  "allowScripts": {
    "@openuidev/lang-core": true,
    "sharp": true,
    "unrs-resolver": true
  }
}
