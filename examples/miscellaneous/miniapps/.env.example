# Main agent (any OpenAI-compatible provider).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
# Optional provider override. Leave unset for OpenAI.
# OPENAI_BASE_URL=https://your-provider.example/v1

# MiniApp generation and stateless script execution (server only).
OPENUI_API_KEY=
OPENUI_MODEL=anthropic/claude-sonnet-4.6
# Optional OpenUI gateway origin. Leave unset for the hosted endpoint.
# OPENUI_API_BASE_URL=https://api.thesys.dev

# Optional: increase GitHub rate limits or access repositories allowed by this token.
# GITHUB_TOKEN=
