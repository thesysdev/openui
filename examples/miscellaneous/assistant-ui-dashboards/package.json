    "@assistant-ui/react-markdown": "^0.14.24",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@openuidev/dashboard-library": "0.0.1",
    "@openuidev/lang-core": "1.0.2",
    "@openuidev/react-headless": "0.18.2",
    "@openuidev/react-lang": "1.0.2",
    "@openuidev/react-ui": "0.18.2",
    "@openuidev/server": "0.4.0",
    "ai": "^7.0.162",
    "assistant-stream": "^0.3.55",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "next": "16.2.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remark-gfm": "^4.0.1",
