# Server-side generation credentials. Calls OpenAI directly, without the Gateway.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
# Optional OpenAI-compatible provider base URL (with that provider's key/model).
# OPENAI_BASE_URL=https://api.openai.com/v1

# Server-side repair credentials. Get a key at https://console.thesys.dev/keys.
THESYS_API_KEY=sk-th-...

# Optional Gateway origin. Defaults to https://api.thesys.dev.
# THESYS_API_BASE_URL=https://api.thesys.dev
