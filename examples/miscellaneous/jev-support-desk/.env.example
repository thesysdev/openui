# Writes new screens. Any OpenAI-compatible endpoint; OpenRouter shown.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-...
OPENAI_MODEL=google/gemini-3.8-flash
# Optional, OpenRouter only: pin one upstream provider.
OPENROUTER_PROVIDER=google-ai-studio

# Jev picks saved screens. https://typesafe.ai
TYPESAFE_API_KEY=apikey_...

# OpenUI Autofix repairs invalid screens. Get one with: pnpm generate:apiKey
THESYS_API_KEY=sk-th-...
