# OpenUI Cloud Gateway key. Create one with `pnpm generate:apiKey`
# or at https://console.thesys.dev/keys.
THESYS_API_KEY=sk-th-...
# Optional: any Gateway model id ({provider}/{model}).
# Catalog: https://www.openui.com/cloud/gateway/models
# OPENUI_MODEL=openai/gpt-5.5

# Slack app tokens (see README): bot token and Socket Mode app-level token.
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
