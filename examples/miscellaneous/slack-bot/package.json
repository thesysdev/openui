{
  "name": "@openuidev/example-slack-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:apiKey": "openui generate-api-key --file .env",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "verify": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.93",
    "@openuidev/channels": "0.1.0",
    "@slack/bolt": "^5.1.0",
    "ai": "^7.0.176",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@openuidev/cli": "0.6.3",
    "@types/node": "^22.15.32",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "allowScripts": {
    "esbuild": true
  }
