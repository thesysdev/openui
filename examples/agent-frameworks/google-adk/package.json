{
  "name": "@openuidev/example-google-adk",
  "version": "0.1.0",
  "private": true,
  "description": "OpenUI generative-UI chat backed by a Google ADK (TypeScript) agent.",
  "scripts": {
    "generate": "openui generate src/library.ts --spec --out src/generated/spec.json",
    "generate:apiKey": "openui generate-api-key --file .env.local",
    "predev": "npm run generate",
    "dev": "next dev",
    "prebuild": "npm run generate",
    "build": "next build",
    "preverify": "npm run generate",
    "verify": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@google/adk": "^1.2.0",
    "@openuidev/lang-core": "1.0.2",
    "@openuidev/react-headless": "0.18.1",
    "@openuidev/react-lang": "1.0.2",
    "@openuidev/react-ui": "0.18.1",
    "adk-llm-bridge": "^0.5.3",
    "next": "^16.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.0.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@openuidev/cli": "0.6.1",
    "@types/node": "^22.15.32",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "typescript": "^5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@openuidev/lang-core",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10",
      "uuid@<11.1.1": "^11.1.1",
      "proxy-addr@<2.0.8": "^2.0.8",
      "mariadb@<3.5.4": "^3.5.4",
      "mysql2@<3.23.1": "^3.23.1",
      "fast-uri@<3.1.8": "^3.1.8",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=5 <5.0.12": "^5.0.12",
      "@grpc/grpc-js@<1.14.5": "^1.14.5",
      "source-map-js@<1.2.2": "^1.2.2",
      "@modelcontextprotocol/sdk@<1.32.0": "^1.32.0",
      "@opentelemetry/core@<2.8.0": "^2.8.0",
      "qs@<6.16.0": "^6.16.0",
      "ip-address@<10.7.4": "^10.7.4",
      "hono@<4.13.11": "^4.13.11",
      "node-gyp@<11": "^11.5.0",
      "adm-zip@<0.6.1": "^0.6.1",
      "tar@<7.5.21": "^7.5.21"
    }
  },
  "allowScripts": {
    "@openuidev/lang-core": true,
    "sharp": true,
    "unrs-resolver": true
  }
}
