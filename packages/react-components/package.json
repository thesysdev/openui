{
  "name": "@openuidev/react-components",
  "version": "0.0.1",
  "description": "Reusable OpenUI React components and themes",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles": {
      "import": {
        "types": "./dist/styles.d.mts",
        "default": "./dist/styles.mjs"
      },
      "require": {
        "types": "./dist/styles.d.cts",
        "default": "./dist/styles.cjs"
      }
    }
  },
  "sideEffects": [
    "./src/index.ts",
    "./src/styles/defaults.ts",
    "./dist/index.mjs",
    "./dist/index.cjs",
    "./dist/styles/defaults.mjs",
    "./dist/styles/defaults.cjs"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint:check": "eslint ./src",
    "lint:fix": "eslint ./src --fix"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.0 || ^4.0.0",
    "zustand": "^4.5.5"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "goober": "2.1.19",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-toggle-group": "^1.1.2",
    "@radix-ui/react-select": "^2.1.5",
    "@radix-ui/react-slider": "^1.2.2",
    "@floating-ui/react-dom": "^2.1.2",
    "react-day-picker": "^9.5.1",
    "date-fns": "^4.1.0",
    "lodash-es": "^4.17.21",
    "lucide-react": "^0.562.0",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@radix-ui/react-aspect-ratio": "^1.1.1",
    "react-syntax-highlighter": "^16.1.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "unist-util-visit": "^5.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "katex": "^0.16.0",
    "@tanstack/react-table": "^8.21.3",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/lodash-es": "^4.17.12",
    "zod": "catalog:",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-shape": "^3.1.8",
    "zustand": "^4.5.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thesysdev/openui.git",
    "directory": "packages/react-components"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
