{
  "name": "@openuidev/dashboard-library",
  "version": "1.0.0",
  "description": "OpenUI Lang component library for analytics dashboards: filters, headline numbers, charts, tables and maps a model composes into a dashboard",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint:check": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "format:check": "prettier --check ./src",
    "format:fix": "prettier --write ./src",
    "check:publint": "publint",
    "check:attw": "attw --pack . --ignore-rules no-resolution",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run check:publint && pnpm run check:attw",
    "ci": "pnpm run lint:check && pnpm run format:check && pnpm run typecheck"
  },
  "dependencies": {
    "@openuidev/react-components": "workspace:>=0.0.1 <0.1.0",
    "@openuidev/react-lang": "workspace:>=1.0.1 <2.0.0",
    "recharts": "^3.8.0",
    "d3-geo": "^3.1.2",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1",
    "world-atlas": "^2.0.2"
  },
  "peerDependencies": {
    "react": "catalog:",
    "zod": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "react": "catalog:",
    "zod": "catalog:",
    "react-dom": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5"
  },
  "keywords": [
    "openui",
    "dashboard",
    "generative-ui",
    "ai",
    "component-library",
    "openui-lang",
    "charts",
    "llm",
    "maps",
    "recharts",
    "analytics",
    "react"
  ],
  "homepage": "https://openui.com",
  "author": "engineering@thesys.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thesysdev/openui.git",
    "directory": "packages/libraries/dashboard"
  },
  "bugs": {
    "url": "https://github.com/thesysdev/openui/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
