{
  "name": "@openuidev/dashboard-library",
  "version": "0.0.2",
  "description": "OpenUI dashboard AI component library: the Dashboard/Section/CardRow layout grammar, filters, cards and charts a model composes into dashboards",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint:check": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "format:check": "prettier --check ./src",
    "format:fix": "prettier --write ./src",
    "check:publint": "publint",
    "check:attw": "attw --pack . --ignore-rules no-resolution",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run check:publint && pnpm run check:attw",
    "ci": "pnpm run lint:check && pnpm run format:check && pnpm run typecheck"
  },
  "dependencies": {
    "@openuidev/react-components": "workspace:>=0.0.1 <0.1.0",
    "@openuidev/react-lang": "workspace:>=1.0.1 <2.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "remark-gfm": "^4.0.1"
  },
  "peerDependencies": {
    "react": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "react": "catalog:",
    "zod": "catalog:"
  },
  "keywords": [
    "openui",
    "dashboard",
    "generative-ui",
    "ai",
    "component-library",
    "openui-lang",
    "charts",
    "llm"
  ],
  "homepage": "https://openui.com",
  "author": "engineering@thesys.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thesysdev/openui.git",
    "directory": "packages/libraries/dashboard"
  },
  "bugs": {
    "url": "https://github.com/thesysdev/openui/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
