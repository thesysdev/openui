{
  "name": "@openuidev/dashboard-kit",
  "version": "0.0.0-beta.0",
  "description": "OpenUI dashboard AI component library: the Dashboard/Section/CardRow layout grammar, filters, cards and charts a model composes into dashboards",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./lib": {
      "import": {
        "types": "./dist/lib/index.d.mts",
        "default": "./dist/lib/index.mjs"
      },
      "require": {
        "types": "./dist/lib/index.d.cts",
        "default": "./dist/lib/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint:check": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "format:check": "prettier --check ./src",
    "format:fix": "prettier --write ./src",
    "check:publint": "publint",
    "check:attw": "attw --pack . --ignore-rules no-resolution",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run check:publint && pnpm run check:attw",
    "ci": "pnpm run lint:check && pnpm run format:check && pnpm run typecheck"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "goober": "2.1.19",
    "lucide-react": "^0.562.0",
    "remark-gfm": "^4.0.1"
  },
  "peerDependencies": {
    "@openuidev/react-components": ">=0.0.1 <0.1.0",
    "@openuidev/react-lang": ">=1.0.1 <2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.76 || ^4.0.0"
  },
  "devDependencies": {
    "@openuidev/react-components": "workspace:^",
    "@openuidev/react-lang": "workspace:^",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "catalog:"
  },
  "keywords": [
    "openui",
    "dashboard",
    "generative-ui",
    "ai",
    "component-library",
    "openui-lang",
    "charts",
    "llm"
  ],
  "homepage": "https://openui.com",
  "author": "engineering@thesys.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thesysdev/openui.git",
    "directory": "packages/kits/dashboard"
  },
  "bugs": {
    "url": "https://github.com/thesysdev/openui/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
