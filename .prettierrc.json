{
  "semi": true,
  "trailingComma": "all",
  "singleQuote": false,
  "printWidth": 100,
  "tabWidth": 2,
  "plugins": ["prettier-plugin-organize-imports"],
  "overrides": [
    {
      "files": "docs/content/docs/cookbooks/*.mdx",
      "options": {
        "embeddedLanguageFormatting": "off"
      }
    }
  ]
}
