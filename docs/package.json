{
  "name": "@openuidev/docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "generate:prompts": "pnpm --filter @openuidev/cli build && pnpm exec openui generate lib/chat-library.ts --out generated/chat-system-prompt.txt && pnpm exec openui generate lib/playground-library.ts --out generated/playground-system-prompt.txt && pnpm exec openui generate lib/playground-library.ts --json-schema --out generated/playground-component-spec.json",
    "fetch:tweets": "node scripts/fetch-static-tweets.mjs",
    "build": "next build --no-mangling",
    "dev": "pnpm generate:prompts && next dev",
    "start": "next start",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "eslint",
    "format:fix": "prettier --write .",
    "format:check": "prettier --check .",
    "check:benchmark-agents": "node scripts/check-benchmark-agent-readability.mjs && node scripts/check-benchmark-answer-contracts.mjs",
    "check:benchmark-answer-contracts": "node scripts/check-benchmark-answer-contracts.mjs",
    "audit:benchmark-publication": "node scripts/audit-benchmark-publication.mjs"
  },
  "dependencies": {
    "@openuidev/cli": "workspace:*",
    "@openuidev/lang-core": "workspace:^",
    "@openuidev/react-headless": "workspace:^",
    "@openuidev/react-lang": "workspace:^",
    "@openuidev/react-ui": "workspace:^",
    "@openuidev/thesys": "0.3.2",
    "@openuidev/thesys-server": "0.1.4",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-tooltip": "1.2.7",
    "@takumi-rs/image-response": "^0.68.17",
    "fumadocs-core": "16.9.1",
    "fumadocs-mdx": "14.3.2",
    "fumadocs-ui": "16.9.1",
    "gpt-tokenizer": "^3.4.0",
    "lucide-react": "^0.570.0",
    "mermaid": "^11.16.0",
    "motion": "^12.34.3",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "octokit": "^5.0.0",
    "openai": "^6.22.0",
    "posthog-js": "^1.407.2",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "reodotdev": "^1.1.0",
    "tailwind-merge": "^3.4.1",
    "zod": "^4.3.6",
    "zustand": "4.5.7",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@uiw/react-codemirror": "^4.25.11",
    "react-resizable-panels": "^4.12.2",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/mdx": "^2.0.13",
    "@types/node": "catalog:",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint-config-next": "16.2.6",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "@types/semver": "^7.7.1"
  }
}
