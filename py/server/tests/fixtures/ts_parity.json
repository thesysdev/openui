  "schema": {
   "$defs": {
    "Stack": {
     "type": "object",
     "properties": {
      "children": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/Card"
       }
      }
     },
     "required": [
      "children"
     ]
    },
    "Card": {
     "type": "object",
     "properties": {
      "title": {
       "type": "string"
      },
      "value": {
       "type": "number",
       "minimum": 0
      }
     },
     "required": [
      "title"
     ]
    }
   }
  }
 },
